<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The updater talks to api.github.com and the APK download host. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Police alerts and background scanning (src/alerts.ts, src/background.ts):
         notifications, the vibration pattern, a connectedDevice foreground
         service while the scanner is plugged in, and a CPU wake lock so USB
         reads keep flowing with the screen off (UsbSerialModule.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Hunts (src/location.ts, LocationModule.kt): sightings are tagged with
         the phone's GPS position. The foreground service also carries the
         "location" type so fixes keep coming with the screen off; that needs
         FOREGROUND_SERVICE_LOCATION on Android 14+, but not background
         location, because the service starts while the app is open. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- USB permission itself is granted per-device by the system dialog at
         open() time (see UsbSerialModule.kt); these two declare that the app
         is a USB host at all. "required=false" keeps the APK installable on
         devices without a USB port (the app then just can't connect). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher_light"
      android:roundIcon="@mipmap/ic_launcher_light_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">

      <!-- Notifee's foreground service (src/background.ts). Its AAR merges this
           service in without a type; Android 14+ requires one matching a held
           permission (FOREGROUND_SERVICE_CONNECTED_DEVICE, above), hence
           tools:replace. Same arrangement as super-badger's manifest. -->
      <service
        android:name="app.notifee.core.ForegroundService"
        android:foregroundServiceType="connectedDevice|location"
        android:exported="false"
        tools:replace="android:foregroundServiceType" />

      <!-- Serves the downloaded APK to the system package installer. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updateprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true" />

      <!-- The launcher entries. MainActivity is no longer launchable by itself;
           instead there is one alias per app theme, each with that theme's
           icon, and exactly one is enabled at a time (light by default).
           AppIconModule.kt enables the one matching the current theme when the
           app goes to the background — see src/appIcon.ts. Icon art is
           super-badger's, reused until scanner-specific art exists. -->
      <activity-alias
        android:name=".IconLight"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_light"
        android:roundIcon="@mipmap/ic_launcher_light_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconDark"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_dark"
        android:roundIcon="@mipmap/ic_launcher_dark_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconSlate"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_slate"
        android:roundIcon="@mipmap/ic_launcher_slate_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconSepia"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_sepia"
        android:roundIcon="@mipmap/ic_launcher_sepia_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <activity-alias
        android:name=".IconEmber"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_ember"
        android:roundIcon="@mipmap/ic_launcher_ember_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>
    </application>
</manifest>
